{
  "name": "@ibtatech/leads",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./domain": "./src/domain.ts",
    "./audit": "./src/audit.ts",
    "./env-guard": "./src/env-guard.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@ibtatech/config": "*",
    "@ibtatech/types": "*",
    "@ibtatech/utils": "*",
    "@prisma/client": "^6.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "vitest": "^3.2.4"
  }
}
