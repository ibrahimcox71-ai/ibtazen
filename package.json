{
  "name": "ibtatech",
  "version": "0.1.0",
  "private": true,
  "description": "Ibtatech — International Digital Technology & Growth Agency platform (monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @ibtatech/web",
    "dev:mobile": "npm run start --workspace @ibtatech/mobile",
    "build": "npx prisma generate --schema=packages/leads/prisma/schema.prisma && npm run build --workspace @ibtatech/web",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "5.9.3"
  }
}
