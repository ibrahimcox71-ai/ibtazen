# Ibtatech environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# Production boot prints one `[env] ...` line per missing or weak value below
# (apps/web/src/instrumentation.ts, checks in packages/leads/src/env-guard.ts).

# Canonical app URL (used for metadata, sitemap, emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Phase 4 — Lead engine ─────────────────────────────────────────────
# SQLite file URL. Prisma resolves the relative path against the schema dir
# (packages/leads/prisma/), so this lands at packages/leads/prisma/dev.db.
# Portable to Postgres later: switch provider + use a connection URL.
DATABASE_URL="file:./dev.db"
# Booking: Cal.com or Calendly public scheduling link. Leave unset to use
# the built-in /book fallback flow.
# BOOKING_PROVIDER=cal.com       # "cal.com" | "calendly"
# BOOKING_URL=                   # e.g. https://cal.com/ibtatech/discovery
# Transactional email (lead flow + CRM events: proposal sent/accepted,
# contract signed, invoice issued, opt-in portal invite).
# Without a key the transport logs and reports delivered=false — never faked.
# Set these in apps/web/.env.local, which is what Next.js loads at runtime.
# RESEND_API_KEY=               # https://resend.com/api-keys (verified sender domain)
# EMAIL_TRANSPORT=              # "console" forces local logging even when a key exists
# LEAD_NOTIFY_EMAIL=            # admin notice recipient (default: SITE.email)
# EMAIL_FROM=                   # sender identity (default: "Ibtatech <hello@ibtatech.com>")

# ── Phase 5 — Admin CRM (auth + lead management) ──────────────────────
# HMAC secret for session token hashing. REQUIRED in production (≥32 chars).
# Generate: openssl rand -hex 32
# Local dev may omit it (falls back to a throwaway dev secret).
# AUTH_SECRET=
# First-admin bootstrap — only used when the AdminUser table is empty.
# Password must be at least 12 characters. Do not commit real values.
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_NAME=Ibtatech Admin

# ── Phase 24 — Case study media ───────────────────────────────────────
# Where admin-uploaded case study images land on disk (served by
# /api/uploads/case-studies/[file]). Default: <cwd>/uploads/case-studies
# (apps/web/uploads in dev). Never commit the contents of that folder.
# CASE_STUDY_UPLOAD_DIR=

# ── Phase 28 — Site settings (logo + favicon) ─────────────────────────
# Where admin-uploaded brand images land on disk (served by
# /api/uploads/brand/[file], favicon behind the stable /api/uploads/brand/
# favicon alias). Default: <cwd>/uploads/brand (apps/web/uploads in dev).
# BRAND_UPLOAD_DIR=

# ── Analytics (Plausible — cookieless, no consent banner) ──────────────
# Site ID Plausible checks in the script's data-domain attribute.
# Unset = no script loads, so local dev and previews stay quiet.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=ibtatech.com
# Self-hosted Plausible? Point here instead of the public cloud.
# NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io

# ── Future phases ─────────────────────────────────────────────────────
# OPENAI_API_KEY=                 # AI assistant
# STRIPE_SECRET_KEY=              # Billing
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
